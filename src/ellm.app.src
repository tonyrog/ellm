{application, ellm,
 [{description, "Erlang LLM client (OpenAI, Claude)"},
  {vsn, git},
  {modules, ["@@MODULES@@"]},
  {registered, []},
  {env, [{backend, claude},
	 {claude, [{baseurl, "https://api.anthropic.com"},
		   {model, "claude-opus-5-5"},
		   {max_tokens, 16000}]},
	 {openai, [{baseurl, "https://api.openai.com"},
		   {model, "gpt-4o"}]}
	]},
  {applications,[kernel,stdlib,ssl,rester]}
  ]}.
