%% -*- erlang -*-
%% ellm configuration example. Do NOT put real keys in files under git,
%% use "$ENV_VAR" or ".authinfo" (machine anthropic.com / openai.com).
[
 {rester,
  [{ssl_options, [{cacertfile, "/etc/ssl/certs/ca-certificates.crt"}]}]},

 {ellm,
  [{backend, claude},
   {claude, [{baseurl, "https://api.anthropic.com"},
	     %% {apikey, "$ANTHROPIC_API_KEY"}, %% default: env, then ~/.authinfo
	     {model, "claude-opus-5-5"},
	     {max_tokens, 16000}
	     %% {effort, high}
	     %% {fallbacks, none}
	    ]},
   {openai, [{baseurl, "https://api.openai.com"},
	     %% {apikey, "$OPENAI_API_KEY"},
	     {model, "gpt-4o"}]}
  ]}
].
